{
    "name": "vysion/whmcs-virtutel-nbn",
    "description": "WHMCS provisioning module for NBN services via the Virtutel Customer API",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "WHMCS\\Module\\Server\\VirtutelNbn\\": "modules/servers/virtutel_nbn/lib/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "lint": "find modules -name '*.php' -print0 | xargs -0 -n1 php -l"
    }
}
